# API Endpoint URL (used during manual local runs)
VITE_API_URL=http://localhost:5000/api

# API Proxy Target (used inside development Docker container config)
VITE_API_PROXY_TARGET=http://server:5000

# Backend Port (used for Socket.IO direct routing fallbacks in client context)
VITE_SERVER_PORT=5000

# Spline 3D Animation URL (fallback asset asset)
VITE_SPLINE_SCENE_URL=https://prod.spline.design/7NZHW3H-6jQEOxOn/scene.splinecode
