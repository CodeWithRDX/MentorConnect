# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
# For local running: mongodb://127.0.0.1:27017/mentorconnect
# For Docker running: mongodb://mongodb:27017/mentorconnect
MONGODB_URI=mongodb://mongodb:27017/mentorconnect

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-characters-abcdef123456789
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Email Configuration (Optional - set SKIP_EMAIL_VERIFICATION=true to skip verification in development)
SKIP_EMAIL_VERIFICATION=true
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@mentorconnect.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth
# How to get:
#   1. Go to https://console.cloud.google.com
#   2. Create a project → APIs & Services → Credentials
#   3. Create OAuth 2.0 Client ID → Web application
#   4. Add Authorized JavaScript origins: http://localhost:3000
#   5. Add Authorized redirect URIs: http://localhost:3000
#   6. Copy Client ID and Client Secret below
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─────────────────────────────────────────────────────────────────────────────
# WebRTC TURN Server (Optional — only needed for production)
# Development uses Google's free STUN servers automatically (no setup needed).
# For production, add a TURN server for users behind strict firewalls:
#   Option 1: Self-hosted coturn (https://github.com/coturn/coturn)
#   Option 2: Twilio TURN (https://www.twilio.com/stun-turn)
#   Option 3: Metered TURN (https://www.metered.ca/stun-turn)
# Leave blank for development.
# ─────────────────────────────────────────────────────────────────────────────
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
